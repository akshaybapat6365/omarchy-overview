[Unit]
Description=Omarchy Overview: Mission Control workspace & window overview (Quickshell)
Documentation=https://github.com/akshaybapat6365/omarchy-overview#readme
PartOf=graphical-session.target
Requisite=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/qs -c overview
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
